NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Vite development origin. For the built server use http://127.0.0.1:3000.
APP_ORIGIN=http://127.0.0.1:5173
ALLOW_INSECURE_LOOPBACK=true
# Production/LAN requires HTTPS and ALLOW_INSECURE_LOOPBACK=false.
DATABASE_URL=postgresql://jce_runtime:replace_me@127.0.0.1:5432/jce_pos
# Runtime gets only its own credential. Provision/migration/backup connections
# belong in separate ignored files; see docs/runbooks/database-foundation.md.
LOG_LEVEL=info
# Set to an existing path on the PostgreSQL data volume, not an arbitrary disk.
# STORAGE_MONITOR_PATH=C:\Program Files\PostgreSQL\18\data
STORAGE_MIN_FREE_BYTES=5368709120
# Integration tests REQUIRE a separate, disposable database.
# TEST_DATABASE_URL=postgresql://jce_test:replace_me@127.0.0.1:5432/jce_pos_test
# TEST_DATABASE_URL must use an administrator on a dedicated disposable cluster.
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
